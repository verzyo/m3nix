{
  dms,
  themes,
}: {
  pkgs,
  lib,
  config,
  ...
}: let
  root = ./..;

  cfg = config.programs.meowtugen;
  configHome = config.xdg.configHome;

  papirusTheme = "Papirus-Meowtugen";
  papirusDir = "${config.xdg.dataHome}/icons/${papirusTheme}";
  papirusColors = "${config.xdg.cacheHome}/meowtugen/papirus-colors";

  # blue papirus folder icons laid out as an overlay theme, recolored at runtime
  papirusOverlay = pkgs.runCommand "papirus-meowtugen-overlay" {} ''
    SRC="${cfg.papirus.package}/share/icons/Papirus-Dark"
    mkdir -p $out

    sed -e 's/^Name=.*/Name=${papirusTheme}/' \
      -e 's/^Inherits=.*/Inherits=Papirus-Dark,breeze-dark,hicolor/' \
      "$SRC/index.theme" > $out/index.theme

    for DIR in "$SRC"/*/; do
      DIR="''${DIR%/}"
      SIZE="''${DIR##*/}"

      # NNxNN@2x dirs are symlinks to their 1x counterpart
      if [ -L "$DIR" ] && [ "$(readlink "$DIR")" = "''${SIZE%@2x}" ]; then
        if [ -d "$out/''${SIZE%@2x}" ]; then
          ln -s "''${SIZE%@2x}" "$out/$SIZE"
        fi
        continue
      fi

      [ -d "$DIR/places" ] || continue
      mkdir -p "$out/$SIZE/places"

      # every blue folder icon, including aliases like folder.svg
      for ICON in "$DIR"/places/*; do
        NAME="''${ICON##*/}"
        TARGET="$(basename "$(readlink -f "$ICON")")"
        case "$TARGET" in
          folder-blue.svg | folder-blue-* | user-blue.svg | user-blue-*) ;;
          *) continue ;;
        esac

        if [ -L "$ICON" ] && [ "$NAME" != "$TARGET" ] && [ -e "$DIR/places/$TARGET" ]; then
          ln -s "$TARGET" "$out/$SIZE/places/$NAME"
        else
          cp "$ICON" "$out/$SIZE/places/$NAME"
        fi
      done
    done
  '';

  sineModEntry = pkgs.writeText "meowtugen-sine-entry.json" (builtins.toJSON {
    meowtugen = {
      id = "meowtugen";
      name = "meowtugen";
      description = "Live-reloads chrome/meowtugen.css generated by matugen.";
      version = "1.0.0";
      style = {chrome = "userChrome.css";};
      scripts = {"meowtugen.uc.js" = {include = ["chrome://browser/content/browser.xhtml"];};};
      origin = "store";
      enabled = true;
      no-updates = true;
    };
  });

  withSineMod = cfg.zen.enable && cfg.zen.withSine;
  zenCssFile =
    if cfg.zen.withSine
    then "meowtugen.css"
    else "userChrome.css";
in {
  options.programs.meowtugen = {
    enable = lib.mkEnableOption "meowtugen matugen templates";

    autoEnable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Whether to enable all meowtugen app templates by default. Set to false to opt in per app instead.";
    };

    package = lib.mkPackageOption pkgs "matugen" {};

    btop.enable = lib.mkOption {
      type = lib.types.bool;
      default = cfg.autoEnable;
      defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
      description = "Whether to enable the btop template.";
    };

    yazi = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = cfg.autoEnable;
        defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
        description = "Whether to enable the Yazi file manager template.";
      };

      package = lib.mkPackageOption pkgs "yazi" {};
    };

    dolphin = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = cfg.autoEnable;
        defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
        description = "Whether to enable the Dolphin / KDE file manager template. Outside Plasma, Qt apps only read kdeglobals with the kde platform theme; see setQtPlatformTheme.";
      };

      dbusPackage = lib.mkPackageOption pkgs "dbus" {};

      setQtPlatformTheme = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Set qt.platformTheme to kde (and qt.style to breeze) so Qt apps read kdeglobals outside Plasma.";
      };

      iconTheme = lib.mkOption {
        type = lib.types.str;
        default =
          if cfg.papirus.enable
          then papirusTheme
          else "breeze-dark";
        defaultText = lib.literalExpression ''if config.programs.meowtugen.papirus.enable then "${papirusTheme}" else "breeze-dark"'';
        description = "Icon theme written to kdeglobals.";
      };
    };

    papirus = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = cfg.autoEnable;
        defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
        description = "Whether to generate ${papirusTheme}, a Papirus-Dark overlay with folder icons recolored to the matugen primary palette.";
      };

      package = lib.mkPackageOption pkgs "papirus-icon-theme" {};
    };

    discord = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = cfg.autoEnable;
        defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
        description = "Whether to enable the Discord client template.";
      };

      configPath = lib.mkOption {
        type = lib.types.str;
        default = "${configHome}/equibop";
        description = "Discord client config folder path.";
      };
    };

    zed.enable = lib.mkOption {
      type = lib.types.bool;
      default = cfg.autoEnable;
      defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
      description = "Whether to enable the Zed editor template.";
    };

    zen = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = cfg.autoEnable;
        defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
        description = "Whether to enable the Zen browser template.";
      };

      profiles = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = ["default"];
        description = "Zen browser profiles the template is rendered into (and, with withSine, where the Sine mod is installed).";
      };

      withSine = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Write the Zen template to chrome/meowtugen.css and manage the Sine hot-reload mod.";
      };
    };

    foot.enable = lib.mkOption {
      type = lib.types.bool;
      default = cfg.autoEnable;
      defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
      description = "Whether to enable the foot terminal template.";
    };

    niri.enable = lib.mkOption {
      type = lib.types.bool;
      default = cfg.autoEnable;
      defaultText = lib.literalExpression "config.programs.meowtugen.autoEnable";
      description = "Whether to enable the niri wm template.";
    };

    templates = lib.mkOption {
      type = lib.types.attrsOf lib.types.anything;
      default = {};
      description = "Extra templates to load.";
    };
  };

  config = lib.mkIf cfg.enable (lib.mkMerge [
    {
      home.packages = [cfg.package] ++ lib.optional cfg.papirus.enable cfg.papirus.package;

      xdg.configFile."matugen/config.toml".source = (pkgs.formats.toml {}).generate "config.toml" {
        config = {};

        templates = let
          matugenTemplates = "${themes}/templates";
          dmsTemplates = "${dms}/quickshell/matugen/templates";

          discordSplashMerge = pkgs.writeShellScript "meowtugen-discord-splash-merge" ''
            set -eu

            SETTINGS="${cfg.discord.configPath}/settings.json"
            FRAGMENT="${cfg.discord.configPath}/splash-colors.json"

            if [ ! -f "$SETTINGS" ]; then
              echo "meowtugen: $SETTINGS not found, skipping splash merge"
              exit 0
            fi

            TMP="$(mktemp "$SETTINGS.tmp.XXXXXX")"
            trap 'rm -f "$TMP"' EXIT

            ${lib.getExe pkgs.jq} -s '.[0] * .[1]' "$SETTINGS" "$FRAGMENT" > "$TMP"
            ${lib.getExe pkgs.jq} empty "$TMP"

            mv "$TMP" "$SETTINGS"
            trap - EXIT
          '';

          papirusRecolor = pkgs.writeShellScript "meowtugen-papirus-recolor" ''
            set -eu
            export PATH="${lib.makeBinPath [pkgs.coreutils pkgs.findutils pkgs.gnused]}:$PATH"

            SRC="${papirusOverlay}"
            THEME="${papirusDir}"
            COLORS="${papirusColors}"

            { read -r FRONT; read -r BACK; read -r GLYPH; } < "$COLORS"

            STAMP="$SRC $FRONT $BACK $GLYPH"
            if [ -f "$THEME/.stamp" ] && [ "$(cat "$THEME/.stamp")" = "$STAMP" ]; then
              exit 0
            fi

            mkdir -p "$(dirname "$THEME")"
            TMP="$(mktemp -d "$THEME.tmp.XXXXXX")"
            trap 'rm -rf "$TMP"' EXIT

            cp -RP "$SRC"/. "$TMP"
            chmod -R u+w "$TMP"
            find "$TMP" -type f -name '*.svg' -exec \
              sed -i -e "s/#5294e2/$FRONT/gI" -e "s/#4877b1/$BACK/gI" -e "s/#1d344f/$GLYPH/gI" {} +

            printf '%s' "$STAMP" > "$TMP/.stamp"

            rm -rf "$THEME.old"
            if [ -e "$THEME" ]; then
              mv "$THEME" "$THEME.old"
            fi
            mv "$TMP" "$THEME"
            trap - EXIT
            rm -rf "$THEME.old"

            ${lib.getExe' cfg.dolphin.dbusPackage "dbus-send"} --session --type=signal /KIconLoader org.kde.KIconLoader.iconChanged int32:0 2>/dev/null || true
          '';
        in
          lib.optionalAttrs cfg.btop.enable {
            btop = {
              input_path = "${matugenTemplates}/btop.theme";
              output_path = "${configHome}/btop/themes/meowtugen.theme";
              post_hook = "pkill -USR2 btop || true";
            };
          }
          // lib.optionalAttrs cfg.yazi.enable {
            yazi = {
              input_path = "${matugenTemplates}/yazi-theme.toml";
              output_path = "${configHome}/yazi/theme.toml";
              post_hook = "${lib.getExe' cfg.yazi.package "ya"} emit-to 0 app:theme </dev/null >/dev/null 2>&1 || true";
            };
          }
          // lib.optionalAttrs cfg.dolphin.enable {
            dolphin = {
              input_path = pkgs.replaceVars "${root}/templates/kde/kdeglobals" {
                inherit (cfg.dolphin) iconTheme;
              };
              output_path = "${configHome}/kdeglobals";
              post_hook = "${lib.getExe' cfg.dolphin.dbusPackage "dbus-send"} --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:0 int32:0 2>/dev/null || true";
            };
          }
          // lib.optionalAttrs cfg.papirus.enable {
            papirus = {
              input_path = "${root}/templates/papirus/colors";
              output_path = papirusColors;
              post_hook = "${papirusRecolor}";
            };
          }
          // lib.optionalAttrs cfg.discord.enable {
            discord = {
              input_path = "${dmsTemplates}/vesktop.css";
              output_path = "${cfg.discord.configPath}/themes/meowtugen.css";
            };

            discord_splash = {
              input_path = "${root}/templates/discord-splash.json";
              output_path = "${cfg.discord.configPath}/splash-colors.json";
              post_hook = "${discordSplashMerge}";
            };
          }
          // lib.optionalAttrs cfg.zed.enable {
            zed = {
              input_path = "${root}/templates/zed.json";
              output_path = "${configHome}/zed/themes/meowtugen.json";
            };
          }
          // lib.optionalAttrs cfg.zen.enable (lib.listToAttrs (map (profile: {
              name = "zen-${profile}";
              value = {
                input_path = "${root}/templates/zen.css";
                output_path = "${configHome}/zen/${profile}/chrome/${zenCssFile}";
              };
            })
            cfg.zen.profiles))
          // lib.optionalAttrs cfg.foot.enable {
            foot_colors.input_path = "${root}/templates/foot/colors.ini";

            foot_reload = {
              input_path = "${root}/templates/foot/reload.sh";
              output_path = "${configHome}/foot/reload.sh";
              post_hook = "sh ${configHome}/foot/reload.sh";
            };

            foot = {
              input_path = "${root}/templates/foot/foot.ini";
              output_path = "${configHome}/foot/colors.ini";
            };
          }
          // lib.optionalAttrs cfg.niri.enable {
            niri = {
              input_path = "${dmsTemplates}/niri-colors.kdl";
              output_path = "${configHome}/niri/colors.kdl";
            };
          }
          // cfg.templates;
      };
    }
    {
      xdg.configFile = lib.mkIf withSineMod (lib.listToAttrs (lib.concatMap (profile: [
          {
            name = "zen/${profile}/chrome/sine-mods/meowtugen/userChrome.css";
            value.source = "${root}/sine-mod/userChrome.css";
          }
          {
            name = "zen/${profile}/chrome/sine-mods/meowtugen/meowtugen.uc.js";
            value.source = "${root}/sine-mod/meowtugen.uc.js";
          }
        ])
        cfg.zen.profiles));

      home.activation.meowtugenSineMod = lib.mkIf withSineMod (lib.hm.dag.entryAfter ["writeBoundary"] ''
        for PROFILE in ${lib.concatStringsSep " " cfg.zen.profiles}; do
          MODS_FILE="${configHome}/zen/$PROFILE/chrome/sine-mods/mods.json"

          if [ -f "$MODS_FILE" ]; then
            $DRY_RUN_CMD ${lib.getExe pkgs.jq} -s '.[0] * .[1]' "$MODS_FILE" ${sineModEntry} > "$MODS_FILE.tmp" \
              && $DRY_RUN_CMD ${lib.getExe pkgs.jq} empty "$MODS_FILE.tmp" \
              && $DRY_RUN_CMD mv "$MODS_FILE.tmp" "$MODS_FILE" \
              && $VERBOSE_ECHO "meowtugen: registered sine mod in $MODS_FILE"
          else
            $DRY_RUN_CMD mkdir -p "$(dirname "$MODS_FILE")" \
              && $DRY_RUN_CMD cp ${sineModEntry} "$MODS_FILE" \
              && $VERBOSE_ECHO "meowtugen: created $MODS_FILE with sine mod entry"
          fi
        done
      '');
    }
    (lib.mkIf (cfg.dolphin.enable && cfg.dolphin.setQtPlatformTheme) {
      qt = {
        enable = lib.mkDefault true;
        platformTheme.name = lib.mkDefault "kde";
        style.name = lib.mkDefault "breeze";
      };
    })
  ]);
}
